# QQ 邮箱 IMAP 配置(见 SPEC.md §27/§29)
#
# 用法:cp mailbox.toml.example mailbox.toml,填入 QQ 邮箱地址与 IMAP「授权码」。
# mailbox.toml 已在 .gitignore 中,不会入库。
#
# ⚠️ authcode 不是 QQ 登录密码,而是 QQ 邮箱的 IMAP/SMTP「授权码」:
#    QQ 邮箱网页版 → 设置 → 账户 → 开启「IMAP/SMTP 服务」→ 获取授权码。
#
# Indeed 与 LinkedIn 的求职提醒都发到这个邮箱,共用这一份凭据;
# 各源在代码里按发件人精确过滤(Indeed: jobalert.indeed.com;LinkedIn: jobalerts-noreply@linkedin.com)。

host = "imap.qq.com"     # QQ 邮箱 IMAP 服务器
port = 993                # SSL 端口
user = "你的QQ号@qq.com"   # QQ 邮箱地址
authcode = ""             # IMAP 授权码(必填;留空则邮件源静默跳过)
folder = "INBOX"          # 邮箱文件夹
since_days = 8            # 回溯天数(略大于每周采集周期)
